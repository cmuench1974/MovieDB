# Copy this file to .env and fill in the values.
# Never commit a real .env file.

# Optional: TMDB v3 API key. You can also paste it in Admin → TMDB API key.
TMDB_API_KEY=

# Random secret for login sessions (use a long random string).
AUTH_SECRET=replace-with-a-long-random-string

# Admin login (password is hashed on first start; changing it later does not update an existing user)
ADMIN_EMAIL=admin@localhost
ADMIN_PASSWORD=changeme-please

# Optional: require Bearer / X-Stats-Token for GET /api/stats (Homepage widget). Leave empty for public counts.
STATS_API_TOKEN=

# Host folder that Docker mounts into the container at /media (local path only; mapped NAS drives usually cannot be bind-mounted)
MEDIA_PATH=./media

# Started automatically on Windows by scripts/ensure-smb-bridge.ps1 so Docker can list already-mapped SMB shares
SMB_BRIDGE_URL=http://smb-bridge:39221
SMB_BRIDGE_TOKEN=
