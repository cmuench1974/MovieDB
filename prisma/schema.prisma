// PostgreSQL schema for the movie catalog.
// Video files can exist without a movie (unmatched), and one movie can have several files.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String     @id @default(cuid())
  username        String     @unique
  email           String     @unique
  passwordHash    String
  role            UserRole   @default(user)
  notifyNewMovies Boolean    @default(false)
  createdAt       DateTime   @default(now())
  lists           MovieList[]
  listShares      MovieListShare[]
}

enum UserRole {
  user
  admin
}

enum MatchStatus {
  pending
  matched
  needs_review
  ignored
}

enum FolderKind {
  local
  smb
}

enum CreditRole {
  actor
  director
}

model Genre {
  id     String  @id @default(cuid())
  tmdbId Int     @unique
  name   String
  movies Movie[]
}

model Movie {
  id            String      @id @default(cuid())
  tmdbId        Int         @unique
  title         String
  originalTitle String?
  year          Int?
  overview      String?
  runtime       Int?
  voteAverage   Float?
  posterPath    String?
  backdropPath  String?
  releaseDate   String?
  // Kommagetrennte Regie-Namen für Anzeige und Suche (neben MovieCredit).
  directorName  String?
  // Snapshot of the top billed cast from TMDB (name, character, profile path).
  cast          Json?
  genres        Genre[]
  credits       MovieCredit[]
  hidden        Boolean     @default(false)
  videoFiles    VideoFile[]
  listItems     MovieListItem[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([year])
  @@index([title])
  @@index([hidden])
  @@index([directorName])
}

model Person {
  id          String        @id @default(cuid())
  tmdbId      Int           @unique
  name        String
  profilePath String?
  credits     MovieCredit[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([name])
}

model MovieCredit {
  id           String     @id @default(cuid())
  movieId      String
  movie        Movie      @relation(fields: [movieId], references: [id], onDelete: Cascade)
  personId     String
  person       Person     @relation(fields: [personId], references: [id], onDelete: Cascade)
  role         CreditRole
  character    String?
  billingOrder Int        @default(0)

  @@unique([movieId, personId, role])
  @@index([personId, role])
  @@index([movieId, role])
}

model ScanFolder {
  id          String      @id @default(cuid())
  label       String
  kind        FolderKind
  // Local/NFS: absolute path visible inside the container (e.g. /media).
  path        String?
  smbHost     String?
  smbShare    String?
  smbFolder   String?
  smbDomain   String?
  smbUsername String?
  // AES-GCM payload, encrypted with AUTH_SECRET — never send this to the browser.
  smbPassword String?
  lastError   String?
  createdAt   DateTime    @default(now())
  videoFiles  VideoFile[]
}

model VideoFile {
  id          String      @id @default(cuid())
  path        String      @unique
  filename    String
  size        BigInt
  parsedTitle String?
  parsedYear  Int?
  status      MatchStatus @default(pending)
  // Top TMDB search hits stored for the admin review dialog.
  candidates  Json?
  movieId     String?
  movie       Movie?      @relation(fields: [movieId], references: [id], onDelete: SetNull)
  folderId    String?
  folder      ScanFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  lastSeenAt  DateTime    @default(now())
  createdAt   DateTime    @default(now())

  // Eigene Texte pro Version. Leer = Fallback auf Movie/TMDB.
  title     String?
  year      Int?
  overview  String?

  // Technische Metadaten von ffprobe, sonst Hinweise aus dem Dateinamen.
  width           Int?
  height          Int?
  // sd | hd | uhd
  resolutionClass String?
  hdrFormat       String?
  durationSec     Int?
  videoCodec      String?
  audioTracks     Json?
  subtitleTracks  Json?
  probeError      String?
  probedAt        DateTime?

  @@index([status])
  @@index([folderId])
}

model ScanJob {
  id          String    @id @default(cuid())
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  status      String
  filesFound  Int       @default(0)
  matched     Int       @default(0)
  needsReview Int       @default(0)
  error       String?
}

model AppSetting {
  key   String @id
  value String
}

model MovieList {
  id        String           @id @default(cuid())
  name      String
  comment   String?
  ownerId   String
  owner     User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  items     MovieListItem[]
  shares    MovieListShare[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([ownerId])
}

model MovieListItem {
  id       String    @id @default(cuid())
  listId   String
  list     MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  movieId  String
  movie    Movie     @relation(fields: [movieId], references: [id], onDelete: Cascade)
  position Int       @default(0)
  createdAt DateTime @default(now())

  @@unique([listId, movieId])
  @@index([movieId])
}

model MovieListShare {
  listId String
  list   MovieList @relation(fields: [listId], references: [id], onDelete: Cascade)
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([listId, userId])
}
